# Copy to .env and fill in. Never commit .env (it is in .gitignore).

# --- Telegram
BOT_TOKEN=123456789:replace-with-token-from-BotFather
# Numeric Telegram user ids of admins, comma separated (get yours from @userinfobot)
ADMIN_IDS=123456789
SUPPORT_CONTACT=@your_support_username

# --- Infrastructure (docker-compose sets these for the containers automatically)
DATABASE_URL=postgresql+psycopg://market:market@localhost:5432/market
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=market

# --- Personal mode (docs/PERSONAL_MODE.md): bot only for ADMIN_IDS, no payments, OLX public offers
# read at a low rate. false = commercial version (OLX disabled, subscriptions/Stars available).
PERSONAL_MODE=false

# --- Sources. Only "mock" works today: OLX and Allegro Lokalnie are disabled until legal access
# is confirmed (docs/SOURCES.md). Adding them here does not enable fetching.
ENABLED_SOURCES=mock

# --- Payments: disabled | test | live
#  disabled: no invoices (admins can /grant subscriptions)
#  test:     Telegram test environment (bot must be created in the test DC, see docs/PAYMENTS.md)
#  live:     real Telegram Stars, ALSO requires PAYMENTS_LIVE_CONFIRMED=yes
PAYMENTS_MODE=disabled
PAYMENTS_LIVE_CONFIRMED=no

# --- Crypto: blocked by Telegram rules for digital goods. Keep false.
CRYPTO_ENABLED=false
CRYPTO_WEBHOOK_SECRET=

# --- AI (docs/AI.md): disabled | ollama | anthropic | openai_compat
# ollama: local and free. AI_MODEL = a name from `ollama list`, e.g. qwen3:8b (no key needed).
# openai_compat: LM Studio etc., AI_BASE_URL=http://localhost:1234/v1 and AI_MODEL = model id shown by LM Studio.
# anthropic: key from https://platform.claude.com (billed separately from claude.ai subscriptions).
AI_PROVIDER=disabled
AI_API_KEY=
AI_MODEL=
# ollama: empty = http://localhost:11434/v1
AI_BASE_URL=
AI_DAILY_LIMIT=30
# true only for vision models (qwen2.5vl, llava...): the listing photo is sent to the model
AI_VISION=false
# hot-deal mode: the AI reads the description of each deal candidate and drops damaged/locked ones
AI_SCREEN_DEALS=true

# --- Tuning (optional)
LOG_LEVEL=INFO
SCHEDULER_TICK_SECONDS=30
MAX_CHECKS_PER_USER_PER_TICK=3
MAX_CHECKS_PER_TICK=200
NOTIFY_ON_FIRST_RUN=false
COMMAND_RATE_PER_MINUTE=30
RETENTION_LISTINGS_DAYS=30
RETENTION_RUNS_DAYS=14
RETENTION_NOTIFICATIONS_DAYS=90
